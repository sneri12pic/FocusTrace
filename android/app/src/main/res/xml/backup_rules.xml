<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup, API 23-30. Everything else keeps the platform default; only
     the sealed sync refresh token is withheld, as the security baseline
     requires. Its AndroidKeyStore key is never backed up, so a restored copy
     would be undecryptable anyway - this stops it leaving the device at all. -->
<full-backup-content>
    <exclude domain="sharedpref" path="focustrace_sync_credentials.xml" />
</full-backup-content>
