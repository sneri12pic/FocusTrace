<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. Same exclusion as backup_rules.xml, for both cloud backup and
     device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="focustrace_sync_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="focustrace_sync_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
