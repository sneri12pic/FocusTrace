<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. Same exclusions as backup_rules.xml, for both cloud backup and
     device-to-device transfer: on some devices allowBackup="false" would not
     stop a device-to-device transfer, so these rules are the control. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="focustrace_sync_credentials.xml" />
        <exclude domain="sharedpref" path="focustrace_sync_installation.xml" />
        <exclude domain="sharedpref" path="focustrace_health_connect.xml" />
        <exclude domain="database" path="focustrace_health_connect.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="focustrace_sync_credentials.xml" />
        <exclude domain="sharedpref" path="focustrace_sync_installation.xml" />
        <exclude domain="sharedpref" path="focustrace_health_connect.xml" />
        <exclude domain="database" path="focustrace_health_connect.db" />
    </device-transfer>
</data-extraction-rules>
